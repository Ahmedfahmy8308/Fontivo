{
    "name": "Fontivo-ui",
    "version": "1.1.2",
    "description": "Fontivo React 19 Frontend Interface",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\"",
        "test": "vitest run",
        "preview": "vite preview"
    },
    "license": "MIT",
    "dependencies": {
        "clsx": "^2.1.1",
        "lucide-react": "^0.475.0",
        "opentype.js": "^1.3.4",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwind-merge": "^3.0.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "@types/opentype.js": "^1.3.10",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "prettier": "^3.10.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^7.0.2",
        "vite": "^6.1.0",
        "vitest": "^5.1.1"
    }
}
